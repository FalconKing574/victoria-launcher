    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "framer-motion": "^12.42.2",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "typescript": "^5.7.2",
